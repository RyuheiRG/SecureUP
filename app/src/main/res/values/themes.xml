<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Tema de la ventana (solo lo que Compose no controla).
      - parent oscuro: la app es dark-only, así el sistema no pinta una ventana clara.
      - windowBackground con el token Background evita el flash blanco antes del primer frame.
      - Las barras del sistema se manejan en runtime con enableEdgeToEdge(SystemBarStyle.dark).
    -->
    <style name="Theme.SecureUP" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/secureup_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!--
      Splash nativo (SplashScreen API vía androidx.core:core-splashscreen).
      Mismo fondo que el tema principal para que la transición no destelle.
      El icono es el logo de marca con margen: el sistema lo recorta en un
      círculo de 192 dp dentro de un lienzo de 288 dp (ver secureup_splash_icon).
    -->
    <style name="Theme.SecureUP.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/secureup_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/secureup_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.SecureUP</item>
    </style>

</resources>
