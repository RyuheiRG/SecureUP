<?xml version="1.0" encoding="utf-8"?>
<!--
   Reglas para Android 12+ (API 31+).
   docs: https://developer.android.com/about/versions/12/backup-restore
   android:allowBackup="false" desactiva el respaldo en la nube, pero en algunos
   fabricantes NO desactiva la transferencia entre dispositivos (D2D). Como esta app
   guarda un vault de contraseñas y el respaldo es manual, se excluye todo también aquí.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
