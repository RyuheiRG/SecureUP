<?xml version="1.0" encoding="utf-8"?>
<!--
   Reglas para Android 11 y anteriores (en API 31+ se usa data_extraction_rules.xml).
   La app no respalda nada: la bóveda se resguarda manualmente (AGENTS.md §5).
   Se excluyen todos los dominios de forma explícita por si en el futuro se habilita allowBackup.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
